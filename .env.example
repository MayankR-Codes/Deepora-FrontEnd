# Deepora Frontend Configuration

# Port to serve the frontend locally (default: 4173)
FRONTEND_PORT=4173
FRONTEND_HOST=127.0.0.1

# Backend REST API Origin (Optional)
# If left unset, localhost requests automatically connect to http://127.0.0.1:4175
# In production, set this to your hosted backend URL:
# DEEPORA_API_ORIGIN=https://api.yourdomain.com
